# Freesound API key (required for search + preview downloads).
# Get one at https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# OAuth2 credentials (required ONLY for original/lossless downloads).
# Create an app at https://freesound.org/apiv2/ to get these.
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=

# Where soundfetch stores OAuth tokens + config (default: ~/.config/soundfetch)
# SOUNDFETCH_CONFIG_DIR=
